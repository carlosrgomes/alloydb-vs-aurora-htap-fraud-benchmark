# ==============================================================================
# Beyond Aurora: AlloyDB HTAP + SCaNN + Gemini 4 Hydrogen Benchmark Configuration
# Copy this file to `.env` and customize as needed. Never commit `.env` to Git.
# ==============================================================================

# Database Connection Strings (Local Docker Compose defaults)
ALLOYDB_DSN=postgresql://postgres:postgres@localhost:5432/postgres
AURORA_DSN=postgresql://postgres:postgres@localhost:5433/postgres

# Deterministic Benchmark Parameters
BENCHMARK_SEED=42
CONCURRENT_WRITE_TPS=500
LEDGER_SEED_ROWS=2000000
SIGNATURE_SEED_ROWS=500000

# Local Container Resource Limits (Parity Envelope)
CONTAINER_CPUS=4.0
CONTAINER_MEM_LIMIT=16g

# Autonomous Agent Triage Configuration
# Options: deterministic_local | in_db_ml | genai_sdk
AGENT_MODE=deterministic_local
GEMINI_MODEL_ID=gemini-4-hydrogen
GEMINI_Confidence_THRESHOLD=0.85

# Google Cloud / Vertex AI Configuration (Required for in_db_ml or genai_sdk)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GEMINI_API_KEY=

# AWS Region (For Ephemeral Aurora Benchmark)
AWS_REGION=us-east-1
